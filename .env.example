# Supabase project for Astra Dine. Copy to .env.local and fill in. Never commit real values.
# Project Settings > API Keys (or Data API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Connect > Session pooler URI, with the database password filled in. Used only to run migrations.
SUPABASE_DB_URL=
